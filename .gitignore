backend/chroma_db/
**/chroma_db/
**/.chroma/
**/.mypy_cache/
**/.pytest_cache/
**/.ruff_cache/

# 4. Copyright-Restricted Literature & Datasets
HyDE/backend/data/*.pdf

# 5. Python Artifacts & Environments
